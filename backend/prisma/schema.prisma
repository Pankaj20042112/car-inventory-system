datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  password  String
  role      String   @default("user")
  name      String?
  email     String?  @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Vehicle {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  make        String
  model       String
  category    String
  price       Float
  quantity    Int      @default(0)
  imageUrl    String?
  description String?
  powertrain   String?
  acceleration String?
  range        String?
  topSpeed     String?
  horsepower   String?
  transmission String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("vehicles")
}

model Purchase {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo     String
  buyerId       String   @db.ObjectId
  buyerName     String
  buyerEmail    String
  buyerCategory String
  vehicleId     String   @db.ObjectId
  make          String
  model         String
  category      String
  price         Float
  sellerName    String   @default("VeloCity Systems Dealership Group Ltd.")
  createdAt     DateTime @default(now())

  @@map("purchases")
}
